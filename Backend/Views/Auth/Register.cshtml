@model RegisterRequest

<main class="auth-card">
    <h1>Create an account</h1>
    <p class="lead">Register a new volunteer account.</p>

    <div asp-validation-summary="ModelOnly" class="validation"></div>

    <form asp-action="Register" method="post" class="form-wide">
        <div class="field">
            <label asp-for="Name">Full name</label>
            <input asp-for="Name" />
            <span asp-validation-for="Name" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="Email">Email address</label>
            <input asp-for="Email" autocomplete="email" />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="Password">Password</label>
            <input asp-for="Password" type="password" autocomplete="new-password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="ConfirmPassword">Confirm password</label>
            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>

        <div class="actions">
            <button type="submit" class="btn btn-primary btn-block">Create account</button>
        </div>
    </form>

    <p class="small muted" style="margin-top:.75rem">Already have an account? <a asp-action="Login">Sign in</a></p>
</main>
