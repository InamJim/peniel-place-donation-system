@model ReportResult

<h1>Donation reports</h1>

<form method="get" class="filters">
    <div>
        <label>From</label>
        <input type="date" name="from" value="@ViewBag.From" />
    </div>

    <div>
        <label>To</label>
        <input type="date" name="to" value="@ViewBag.To" />
    </div>

    <div>
        <label>Category</label>
        <select name="category">
            <option value="">All categories</option>
            @foreach (var c in DonationCategories.All)
            {
                <option value="@c"
                        selected="@(ViewBag.Category as string == c)">
                    @DonationCategories.Label(c)
                </option>
            }
        </select>
    </div>

    <div>
        <label>Donor</label>
        <select name="donorId">
            <option value="">All donors</option>
            @foreach (Donor d in ViewBag.Donors)
            {
                <option value="@d.Id"
                        selected="@(ViewBag.DonorId is int id && id == d.Id)">
                    @d.Name
                </option>
            }
        </select>
    </div>

    <button type="submit">Run report</button>
</form>

<div class="cards">
    <div class="card">
        <span>Monetary total</span>
        <strong>R@((Model.TotalCents / 100m).ToString("N2"))</strong>
    </div>

    <div class="card">
        <span>Monetary records</span>
        <strong>@Model.MonetaryCount</strong>
    </div>

    <div class="card">
        <span>In-kind records</span>
        <strong>@Model.InKindCount</strong>
    </div>
</div>

<h2>Monetary totals by category</h2>

<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>Category</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.TotalsByCategory)
            {
                <tr>
                    <td>@DonationCategories.Label(item.Key)</td>
                    <td>R@((item.Value / 100m).ToString("N2"))</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<h2>Matching donations</h2>

<partial name="_DonationTable" model="Model.Donations" />