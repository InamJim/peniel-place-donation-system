@model Donor

<h1>@Model.Name</h1>

<section class="panel">
    <p><strong>Email:</strong> @Model.Email</p>
    <p><strong>Phone:</strong> @Model.Phone</p>
    <p><strong>Notes:</strong> @Model.Notes</p>
</section>

<h2>Donation history</h2>

<partial name="_DonationTable" model="Model.Donations" />