@model List<Donor>

<div class="page-title">
    <h1>Donors</h1>
    <a class="button" asp-action="Create">Add donor</a>
</div>

<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model)
            {
                <tr>
                    <td>@d.Name</td>
                    <td>@d.Email</td>
                    <td>@d.Phone</td>
                    <td>
                        <a asp-action="Details"
                           asp-route-id="@d.Id">
                            View
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>