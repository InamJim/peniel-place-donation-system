@model Donation

<section class="panel receipt">
    <h1>Proof of Donation</h1>
    <h2>Peniel Place Ministries</h2>

    <p>
        <strong>Receipt number:</strong>
        @Model.Receipt!.ReceiptNumber
    </p>

    <p>
        <strong>Date received:</strong>
        @Model.ReceivedOn.ToString("yyyy-MM-dd")
    </p>

    <p>
        <strong>Donor:</strong>
        @(Model.Donor?.Name ?? "Not specified")
    </p>

    <p>
        <strong>Category:</strong>
        @DonationCategories.Label(Model.Category)
    </p>

    <p>
        <strong>Contribution:</strong>
        @(Model.Kind == "monetary"
            ? "R" + ((Model.AmountCents ?? 0) / 100m).ToString("N2")
            : Model.Description)
    </p>

    <p class="muted">
        This receipt confirms the contribution recorded
        in the ministry's system.
    </p>

    <button onclick="window.print()" type="button">
        Print receipt
    </button>
</section>