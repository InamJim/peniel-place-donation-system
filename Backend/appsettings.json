{
  // Optional. When omitted the app uses a SQLite file at <content root>/storage/peniel.sqlite.
  // Example override: "ConnectionStrings": { "Default": "Data Source=/var/lib/peniel/peniel.sqlite" }
  "DataProtection": {
    "ApplicationName": "PenielPlaceDonationSystem"
    // Optional. Where the encryption key ring is stored. Defaults to <content root>/storage/keys.
    // BACK THIS UP WITH THE DATABASE: without it, encrypted donor and donation data cannot be read.
    // "KeyPath": "/var/lib/peniel/keys"
  },
  // Never commit real credentials here. Set these with environment variables
  // (BootstrapAdmin__Email / BootstrapAdmin__Password) or `dotnet user-secrets`.
  // They create the first Leadership account when it does not already exist.
  // "BootstrapAdmin": { "Email": "", "Password": "" },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  // Add the real host name(s) when deploying, e.g. "localhost;127.0.0.1;donations.example.org"
  "AllowedHosts": "localhost;127.0.0.1"
}
